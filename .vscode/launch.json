{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Verify",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/ratify",
      "env": {
        "RATIFY_EXPERIMENTAL_DYNAMIC_PLUGINS": "1",
        "RATIFY_LOG_LEVEL": "debug"
      },
      "args": [
        "verify",
        "-s",
        "${input:subject}",
        "-c",
        "${input:configPath}"
      ]
    },
    {
      "name": "Serve",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/ratify",
      "env": {
        "RATIFY_EXPERIMENTAL_DYNAMIC_PLUGINS": "1"
      },
      "args": [
        "serve",
        "--http",
        ":6001"
      ]
    },
    {
      "name": "Serve w/ CRD manager",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/ratify",
      "env": {
        "RATIFY_LOG_LEVEL": "debug",
        "RATIFY_EXPERIMENTAL_DYNAMIC_PLUGINS": "1",
        "RATIFY_NAMESPACE": "gatekeeper-system"
      },
      "args": [
        "serve",
        "--enable-crd-manager",
        "--http",
        ":6001"
      ]
    },
    {
      // This requires:
      // 1. Your kubeconfig to be pointed at a cluster with Ratify CRDs installed
      // 2. Server TLS certs: tls.crt, tls.key, ca.crt, ca.key in a single directory (specified by --cert-dir)
      // 3. One or more client CA certificates for mTLS client authentication (comma-separated paths in --ca-cert-files)
      "name": "Serve w/ CRD manager and TLS enabled",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/ratify",
      "env": {
        "RATIFY_LOG_LEVEL": "debug",
        "RATIFY_EXPERIMENTAL_DYNAMIC_PLUGINS": "1"
      },
      "args": [
        "serve",
        "--enable-crd-manager",
        "--http",
        ":6001",
        "--cert-dir=${input:tlsDir}",
        "--ca-cert-files=${input:clientCACertFiles}",
        "--config=${input:configPath}"
      ]
    },
    {
      "name": "Debug SBOM Plugin",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/plugins/verifier/sbom",
      "env": {
        "RATIFY_EXPERIMENTAL_DYNAMIC_PLUGINS": "1",
        "RATIFY_LOG_LEVEL": "debug",
        "RATIFY_VERIFIER_COMMAND": "VERIFY",
        "RATIFY_VERIFIER_SUBJECT": "wabbitnetworks.azurecr.io/test/image:sbom",
        "RATIFY_VERIFIER_VERSION": "1.0.0"
      },
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "subject",
      "type": "promptString",
      "description": "Subject to verify",
      "default": "wabbitnetworks.azurecr.io/test/notary-image:signed"
    },
    {
      "id": "configPath",
      "type": "promptString",
      "description": "Absolute path to config file",
      "default": "${workspaceFolder}/test/bats/tests/config/config.json"
    },
    {
      "id": "tlsDir",
      "type": "promptString",
      "description": "Absolute path to tls cert and key directory",
      "default": "${workspaceFolder}/tls/certs"
    },
    {
      "id": "clientCACertFiles",
      "type": "promptString",
      "description": "Comma-separated paths to client CA certificate files",
      "default": "${workspaceFolder}/client-ca-cert/ca.crt,${workspaceFolder}/client-ca-cert/custom-ca.crt"
    }
  ]
}
